<!-- rc_Welcome.html — webapp/rc_Welcome.html -->
<!-- Самодостаточная страница приветствия для Telegram Mini App. -->
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="color-scheme" content="light">
    <title>Кроко</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&amp;family=Nunito:wght@700;800&amp;display=swap" rel="stylesheet">
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
/* styles.css — webapp/styles.css */
/* Стили страницы приветствия Mini App. */

:root {
    --mint: #e7f4e3;
    --mint-deep: #cfe8c8;
    --leaf: #2f9a57;
    --leaf-dark: #1f6b3c;
    --ink: #163226;
    --ink-soft: #3d5a4a;
    --card: rgba(255, 255, 255, 0.72);
    --shadow: rgba(46, 92, 58, 0.18);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html,
body {
    min-height: 100%;
}

body {
    font-family: Manrope, "Segoe UI", sans-serif;
    color: var(--ink);
    background:
        radial-gradient(circle at top, #f7fff4 0%, var(--mint) 42%, #d9edd4 100%);
    overflow-x: hidden;
}

.bg-orb {
    position: fixed;
    border-radius: 50%;
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
}

.bg-orb-a {
    width: 220px;
    height: 220px;
    background: rgba(92, 196, 122, 0.28);
    top: -60px;
    right: -50px;
}

.bg-orb-b {
    width: 180px;
    height: 180px;
    background: rgba(255, 214, 102, 0.22);
    bottom: 18%;
    left: -70px;
}

.bg-orb-c {
    width: 140px;
    height: 140px;
    background: rgba(120, 188, 255, 0.16);
    bottom: -40px;
    right: 12%;
}

.screen {
    position: relative;
    z-index: 1;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 24px 20px calc(28px + env(safe-area-inset-bottom));
}

.stage {
    position: relative;
    width: min(100%, 360px);
    height: 340px;
    display: grid;
    place-items: center;
}

.glow {
    position: absolute;
    width: 230px;
    height: 230px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.9) 0%, rgba(184, 230, 170, 0.35) 55%, transparent 72%);
    animation: pulse 2.8s ease-in-out infinite;
}

.shadow {
    position: absolute;
    bottom: 28px;
    width: 150px;
    height: 22px;
    border-radius: 50%;
    background: var(--shadow);
    filter: blur(8px);
    animation: squash 1.35s ease-in-out infinite;
}

.mascot {
    position: relative;
    z-index: 2;
    width: min(88vw, 320px);
    height: auto;
    transform-origin: 50% 86%;
    animation: wave 1.35s ease-in-out infinite;
    user-select: none;
    -webkit-user-drag: none;
}

.hi-bubble {
    position: absolute;
    top: 28px;
    right: 18px;
    z-index: 3;
    font-family: Nunito, Manrope, sans-serif;
    font-weight: 800;
    font-size: 18px;
    color: var(--leaf-dark);
    background: #fff;
    padding: 10px 16px;
    border-radius: 18px 18px 18px 6px;
    box-shadow: 0 10px 24px var(--shadow);
    animation: pop 1.35s ease-in-out infinite;
}

.hi-bubble::after {
    content: "";
    position: absolute;
    left: 18px;
    bottom: -8px;
    border: 8px solid transparent;
    border-top-color: #fff;
    border-left: 0;
}

.card {
    width: min(100%, 380px);
    background: var(--card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 28px;
    padding: 22px 22px 24px;
    box-shadow: 0 18px 40px rgba(31, 79, 48, 0.12);
}

.badge {
    display: inline-block;
    font-family: Nunito, Manrope, sans-serif;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(135deg, var(--leaf) 0%, var(--leaf-dark) 100%);
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 14px;
}

.lead,
.note {
    line-height: 1.55;
}

.lead {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 12px;
}

.note {
    font-size: 16px;
    font-weight: 500;
    color: var(--ink-soft);
}

@keyframes wave {
    0%,
    100% {
        transform: rotate(-8deg) translateY(0);
    }
    50% {
        transform: rotate(10deg) translateY(-10px);
    }
}

@keyframes squash {
    0%,
    100% {
        transform: scaleX(1);
        opacity: 0.45;
    }
    50% {
        transform: scaleX(0.78);
        opacity: 0.28;
    }
}

@keyframes pulse {
    0%,
    100% {
        transform: scale(1);
        opacity: 0.85;
    }
    50% {
        transform: scale(1.08);
        opacity: 1;
    }
}

@keyframes pop {
    0%,
    100% {
        transform: translateY(0) rotate(-4deg);
    }
    50% {
        transform: translateY(-7px) rotate(3deg);
    }
}

@media (max-width: 360px) {
    .stage {
        height: 290px;
    }

    .lead {
        font-size: 18px;
    }

    .note {
        font-size: 15px;
    }
}

    </style>
</head>
<body>
    <div class="bg-orb bg-orb-a"></div>
    <div class="bg-orb bg-orb-b"></div>
    <div class="bg-orb bg-orb-c"></div>

    <main class="screen">
        <section class="stage">
            <div class="glow"></div>
            <div class="shadow"></div>
            <p class="hi-bubble">Привет!</p>
            <img class="mascot" src="data:image/png;base64," alt="Кроко машет лапкой">
        </section>

        <section class="card">
            <p class="badge">Кроко</p>
            <p class="lead">
                Привет, я бот анкетирования. Зови меня Кроко.
                Обращайся ко мне так же.
            </p>
            <p class="note">
                Можешь написать прямо мне в бот, обращаясь ко мне — я постараюсь среагировать.
            </p>
        </section>
    </main>

    <script>
// script.js — webapp/script.js
// Логика приветствия и связь Mini App с ботом.
const app = window.Telegram && window.Telegram.WebApp;

if (app) {
    app.ready();
    app.expand();
    app.setHeaderColor("#e7f4e3");
    app.setBackgroundColor("#e7f4e3");
}

    </script>
</body>
</html>
